# ==============================================================================
# OLTAPI - Configurações de Ambiente de Produção / Homologação
# Copie este arquivo para .env e ajuste as variáveis conforme seu ambiente
# ==============================================================================

# Identificação do Projeto
PROJECT_NAME="OLT Provisioning & Diagnostics API"
VERSION="1.0.0"

# Segurança: Chave de API secreta para o header X-API-Key (OBRIGATÓRIO ALTERAR EM PRODUÇÃO)
API_KEY=oltapi_secret_default_key_change_me

# Conexão de Rede com as OLTs (Timeout de SSH/Telnet em segundos)
DEFAULT_SSH_TIMEOUT=15

# Política de Backup e Retenção
BACKUP_RETENTION_MAX=30
BACKUP_RETENTION_DAYS=60

# Nível de Log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Porta de Escuta do Servidor
PORT=8000
