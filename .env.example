# ==============================================================================
# OLT Provisioning & Diagnostics API - Environment Configuration Example
# ==============================================================================
# Renomeie este arquivo para .env e preencha com as credenciais do seu ambiente.
# NUNCA comite o arquivo .env preenchido no repositório Git!
# ==============================================================================

PROJECT_NAME="OLT Provisioning & Diagnostics API"
API_KEY="oltapi_secret_default_key_change_me"
# Chave Mestra Fernet AES-256 para Criptografia de Credenciais em Repouso no PostgreSQL
# Para gerar uma nova chave execute: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_ENCRYPTION_KEY="sua_chave_fernet_aes256_base64_aqui"
# Banco de Dados Relacional PostgreSQL 16
POSTGRES_USER="oltuser"
POSTGRES_PASSWORD="sua_senha_do_banco_aqui"
POSTGRES_DB="oltapi"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
# DATABASE_URL é opcional; se vazia, é gerada automaticamente usando as variáveis POSTGRES_* acima
DATABASE_URL=""
PORT=8000
LOG_LEVEL="INFO"

# Configurações de Retenção e Expurgos de Backup
BACKUP_RETENTION_MAX=30
BACKUP_RETENTION_DAYS=60
DEFAULT_SSH_TIMEOUT=15

# Credenciais Padrão de Bancada / Homologação (Opcionais para Auto-Seed)
OLT_DEFAULT_NAME="OLT VTX"
OLT_DEFAULT_VENDOR="fiberhome"
OLT_DEFAULT_MODEL="an5516"
OLT_DEFAULT_HOST="192.168.1.100"
OLT_DEFAULT_PORT=23
OLT_DEFAULT_PROTOCOL="telnet"
OLT_DEFAULT_USER="admin"
OLT_DEFAULT_PASS="sua_senha_olt_aqui"

# Servidor FTP Central de Backup (Opcional para Auto-Seed)
FTP_DEFAULT_NAME="FTP-PROD-CENTRAL"
FTP_DEFAULT_HOST="192.0.2.10"
FTP_DEFAULT_PORT=21
FTP_DEFAULT_USER="ftp_user"
FTP_DEFAULT_PASS="sua_senha_ftp_aqui"
FTP_DEFAULT_BASE_PATH="/"
FTP_DEFAULT_IS_GLOBAL=true
